
universe = vanilla

# Define initial directory
initial_dir = $(target_dir)
# Define executable and input
# Path relative to the working directory where condor_submit is executed from (opaka_sim_runs)
executable = ./scripts/create_OMEM_wrapper_LRF_Selex_poorrec.sh

# Error logging
log = job_$(Cluster)_$(Process).log
error = job_$(Cluster)_$(Process).err
output = job_$(Cluster)_$(Process).out

# Define singularity
+SingularityImage = "osdf:///ospool/ap41/data/meg_oshima/linux-r4ss-v10.sif"

# Define resources
request_cpus = 1
request_memory = 2GB
request_disk = 7GB

# Define arguments
arguments = $(target_dir)

# Define project
+ProjectName = "osg.NOAA_DucharmeBarth"

# Define input files
should_transfer_files = YES
# Path relative to 'target_dir'
transfer_input_files = ../../scripts/OSG_LRF_Selex_poorrec.r, start.tar.gz

# Define output files
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files = End.tar.gz

# Define queue
# Path relative to the working directory where condor_submit is executed from
queue target_dir from ./LRFSelex_poorrec_25_yrfwd/target_dirs.txt
